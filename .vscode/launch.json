{
  "version": "0.2.0",
  "configurations": [
    {
      // Backend: ASP.NET Core API on http://localhost:8282 (the port the Vite dev server proxies /api to).
      // Reads Config/appsettings.Development.json (database + AccountServer) from the build output.
      "name": "aidashboard: API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build aidashboard",
      "program": "${workspaceFolder}/aiteam/aidashboard/bin/Debug/net10.0/aidashboard.dll",
      "args": [],
      "cwd": "${workspaceFolder}/aiteam/aidashboard",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8282"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // Frontend: Vite dev server with hot reload on http://localhost:8281. Once it is up, VS Code opens
      // Chrome with the JS debugger attached, so breakpoints in js/*.jsx work.
      "name": "aidashboard: Frontend (Vite + Chrome)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/aiteam/aidashboard",
      // Must match uriFormat below and ASPNETCORE_URLS of the API configuration.
      "env": {
        "AIDASHBOARD_DEV_PORT": "8281",
        "AIDASHBOARD_API_URL": "http://localhost:8282"
      },
      "serverReadyAction": {
        "pattern": "Local:",
        "uriFormat": "http://localhost:8281",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/aiteam/aidashboard"
      }
    }
  ],
  "compounds": [
    {
      // F5 target for day-to-day work: API + Vite + browser, stopped together.
      "name": "aidashboard: Full stack",
      "configurations": ["aidashboard: API (.NET)", "aidashboard: Frontend (Vite + Chrome)"],
      "stopAll": true
    }
  ]
}
