{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AI Worker (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build aiworker",
      "program": "${workspaceFolder}/aiteam/aiworker/src/CodingAgent/bin/Debug/net10.0/CodingAgent.dll",
      "args": [],
      "cwd": "${input:targetRepository}",
      "envFile": "${workspaceFolder}/aiteam/.env",
      "env": {
        "WORKSPACE_PATH": "${input:targetRepository}"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "targetRepository",
      "type": "promptString",
      "description": "Absolute path to the code repository the worker should modify",
      "default": "${workspaceFolder}"
    }
  ]
}
