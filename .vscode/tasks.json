      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/aiteam/aiworker/src/CodingAgent/CodingAgent.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test aiworker",
      "type": "process",
