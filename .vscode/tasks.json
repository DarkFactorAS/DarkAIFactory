      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "test aiclaudeworker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/aiteam/aiclaudeworker/ClaudeCodingAgent.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
