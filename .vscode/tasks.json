{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build aiworker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/aiteam/aiworker/src/CodingAgent/CodingAgent.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test aiworker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/aiteam/aiworker/CodingAgent.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
