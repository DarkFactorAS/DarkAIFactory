MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=aiteam
MARIADB_USER=aiteam
MARIADB_PASSWORD=
MARIADB_VOLUME_NAME=aiteam_mariadb_data
CLAUDE_CONFIG_VOLUME_NAME=aiteam_claude_config
ADMINER_PORT=8180
AITEAM_CONFIG_PATH=./config
AIDASHBOARD_CONFIG_PATH=./aidashboard/runtime-config
DOTNET_ENVIRONMENT=Production
NUGET_USERNAME=
NUGET_TOKEN=
# aidashboard write token (Bearer token for comments and agent changes; empty disables writes)
DASHBOARD_WRITE_TOKEN=

# Number of aiagent containers
AIAGENT_INSTANCES=3
# Agents run by each aiagent container (1-3); a separate setting from AIAGENT_INSTANCES
AIAGENT_AGENTS_PER_INSTANCE=1
# Runner job slots; should be at least AIAGENT_INSTANCES x AIAGENT_AGENTS_PER_INSTANCE (default 3)
# AIAGENT_RUNNER_MAX_JOBS=3
