<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep tests and frontend sources out of the web project build and publish output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;js/**;css/**;dist/**;node_modules/**;index.html;package.json;package-lock.json;vite.config.js;NuGet.config</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/*.cs" Link="Configuration/%(Filename)%(Extension)" />
    <PackageReference Include="DarkFactor.Common.Lib" Version="1.6.6" />
    <Content Remove="Config/appsettings.template.json" />
    <Content Update="Config/appsettings.*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
